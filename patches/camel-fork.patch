From 7fe5f036c1abc0a0a1724885561f632310b6d2a9 Mon Sep 17 00:00:00 2001
From: Muhammad Hany <dev.mhany@gmail.com>
Date: Fri, 15 May 2026 22:18:28 +0300
Subject: [PATCH 3/8] Add error handling for search_you

Wrap the request in try/except, distinguishing Timeout, HTTPError,
generic RequestException, and unexpected exceptions so callers always
receive a structured [{"error": ...}] payload instead of a traceback.
Non-2xx status codes are also surfaced as errors and logged via the
module logger, matching the Bocha and Querit handling pattern.
---
 camel/toolkits/search_toolkit.py | 63 ++++++++++++++++++++++++++++++--
 1 file changed, 59 insertions(+), 4 deletions(-)

diff --git a/camel/toolkits/search_toolkit.py b/camel/toolkits/search_toolkit.py
index 06822f1c..4074adf7 100644
--- a/camel/toolkits/search_toolkit.py
+++ b/camel/toolkits/search_toolkit.py
@@ -846,10 +846,65 @@ class SearchToolkit(BaseToolkit):
         if search_lang is not None:
             params["search_lang"] = search_lang
 
-        response = requests.get(
-            url, headers=headers, params=params, timeout=self.timeout
-        )
-        web_results = response.json().get("results", {}).get("web", [])
+        try:
+            response = requests.get(
+                url,
+                headers=headers,
+                params=params,
+                timeout=self.timeout,
+            )
+
+            if response.status_code != 200:
+                logger.warning(
+                    "You.com search returned HTTP "
+                    f"{response.status_code}: {response.text}"
+                )
+                return [
+                    {
+                        "error": (
+                            f"You.com API failed with status "
+                            f"{response.status_code}: {response.text}"
+                        )
+                    }
+                ]
+
+            web_results = (
+                response.json().get("results", {}).get("web", [])
+            )
+        except requests.exceptions.Timeout as e:
+            logger.warning(f"You.com search timed out: {e!s}")
+            return [{"error": f"You.com search timed out: {e!s}"}]
+        except requests.exceptions.HTTPError as e:
+            status = (
+                e.response.status_code
+                if e.response is not None
+                else "unknown"
+            )
+            logger.warning(
+                f"You.com search HTTP error {status}: {e!s}"
+            )
+            return [
+                {
+                    "error": (
+                        f"You.com search HTTP error {status}: {e!s}"
+                    )
+                }
+            ]
+        except requests.exceptions.RequestException as e:
+            logger.warning(f"You.com search request failed: {e!s}")
+            return [{"error": f"You.com search request failed: {e!s}"}]
+        except Exception as e:
+            logger.warning(
+                f"Unexpected error during You.com search: {e!s}"
+            )
+            return [
+                {
+                    "error": (
+                        f"Unexpected error during You.com search: "
+                        f"{e!s}"
+                    )
+                }
+            ]
 
         results: List[Dict[str, Any]] = []
         for idx, item in enumerate(web_results, 1):
-- 
