From c8d203257270df4ded6f062eb35b309690e07684 Mon Sep 17 00:00:00 2001
From: Muhammad Hany <dev.mhany@gmail.com>
Date: Fri, 15 May 2026 22:18:08 +0300
Subject: [PATCH 2/8] Implement You.com Search API wrapper

Replace the placeholder body with a plain requests.get call against
https://ydc-index.io/v1/search using the X-API-Key header. Parse
results.web[] into the camel-standard {result_id, title, description,
long_description, url} shape, joining snippets[] for long_description
to give agents richer context. Optional country and search_lang query
params are dropped when None so callers only opt in when needed.
---
 camel/toolkits/search_toolkit.py | 32 +++++++++++++++++++++++++++++++-
 1 file changed, 31 insertions(+), 1 deletion(-)

diff --git a/camel/toolkits/search_toolkit.py b/camel/toolkits/search_toolkit.py
index fdd4eb0c..06822f1c 100644
--- a/camel/toolkits/search_toolkit.py
+++ b/camel/toolkits/search_toolkit.py
@@ -833,7 +833,37 @@ class SearchToolkit(BaseToolkit):
                 On failure a single-element list ``[{"error": "..."}]``
                 is returned.
         """
-        raise NotImplementedError
+        YOU_API_KEY = os.environ.get("YOU_API_KEY")
+
+        url = "https://ydc-index.io/v1/search"
+        headers = {"X-API-Key": YOU_API_KEY}
+        params: Dict[str, Any] = {
+            "query": query,
+            "count": number_of_result_pages,
+        }
+        if country is not None:
+            params["country"] = country
+        if search_lang is not None:
+            params["search_lang"] = search_lang
+
+        response = requests.get(
+            url, headers=headers, params=params, timeout=self.timeout
+        )
+        web_results = response.json().get("results", {}).get("web", [])
+
+        results: List[Dict[str, Any]] = []
+        for idx, item in enumerate(web_results, 1):
+            snippets = item.get("snippets") or []
+            results.append(
+                {
+                    "result_id": idx,
+                    "title": item.get("title", ""),
+                    "description": item.get("description", ""),
+                    "long_description": "\n".join(snippets),
+                    "url": item.get("url", ""),
+                }
+            )
+        return results
 
     @api_keys_required([(None, 'BOCHA_API_KEY')])
     def search_bocha(
-- 
